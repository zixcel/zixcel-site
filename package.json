{
  "name": "@zixcel/zixcel-site",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.29.3"
  },
  "scripts": {
    "site": "nuxtjp-localized-site site",
    "validate:content": "nuxtjp-localized-site site check",
    "test": "nuxtjp-localized-site site check && pnpm run test:dependency-security && pnpm run test:site-structure && node --test site/experience.cases.mts && pnpm run test:source-languages",
    "typecheck": "nuxtjp-localized-site site typecheck",
    "build": "nuxtjp-localized-site site build",
    "dev": "nuxtjp-localized-site site dev",
    "preview": "nuxtjp-localized-site site preview",
    "test:dependency-security": "node --test scripts/dependency-security.check.cjs",
    "test:site-structure": "node --test site/navigation.test.mts && node site/check.mts",
    "test:source-languages": "node --test site/content-input.test.mts site/source-languages.test.mts && node site/source-languages.mts && tsc -p site/tsconfig.check.json"
  },
  "dependencies": {
    "@nuxtjp/localized-site": "0.2.6",
    "nuxt": "4.6.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.2"
  },
  "pnpm": {
    "overrides": {
      "@nuxt/devtools>simple-git": "4.0.2"
    },
    "patchedDependencies": {
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "node-forge@1.4.0": "patches/node-forge@1.4.0.patch"
    }
  }
}
