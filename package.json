{
  "name": "@zixcel/zixcel-site",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "10.29.3"
  },
  "scripts": {
    "site": "nuxtjp-localized-site site",
    "validate:content": "nuxtjp-localized-site site check",
    "test": "nuxtjp-localized-site site check && pnpm run test:dependency-security && pnpm run test:site-structure && node --test site/experience.cases.mts && pnpm run test:source-languages",
    "typecheck": "nuxtjp-localized-site site typecheck",
    "build": "nuxtjp-localized-site site build",
    "dev": "nuxtjp-localized-site site dev",
    "preview": "nuxtjp-localized-site site preview",
    "test:dependency-security": "nuxtjp-security-check --project-root .",
    "test:site-structure": "node --test site/navigation.test.mts && node site/check.mts",
    "test:source-languages": "node --test site/content-input.test.mts site/source-languages.test.mts && node site/source-languages.mts && tsc -p site/tsconfig.check.json"
  },
  "dependencies": {
    "@nuxtjp/contact-form": "0.1.0",
    "@nuxtjp/localized-site": "0.5.0",
    "nuxt": "4.6.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@nuxtjp/dependency-security": "0.2.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.2"
  },
  "pnpm": {
    "overrides": {
      "simple-git": "4.0.2",
      "@simple-git/argv-parser": "2.0.1",
      "esbuild": "0.28.2",
      "undici@6": "6.29.1",
      "undici@7": "7.30.1",
      "undici@8": "8.12.2",
      "serialize-javascript@7": "7.1.3",
      "fast-uri@3": "3.1.9"
    },
    "patchedDependencies": {
      "braces@3.0.3": ".nuxtjp-security/braces-3.0.3.patch",
      "node-forge@1.4.0": ".nuxtjp-security/node-forge-1.4.0.patch"
    }
  }
}
